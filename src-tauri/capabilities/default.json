{
  "identifier": "default",
  "description": "Default capabilities for Personal Archive",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    {
      "identifier": "sql:allow-load",
      "allow": [{ "url": "sqlite:archive.db" }]
    },
    {
      "identifier": "sql:allow-execute",
      "allow": [{ "url": "sqlite:archive.db" }]
    },
    {
      "identifier": "sql:allow-select",
      "allow": [{ "url": "sqlite:archive.db" }]
    }
  ]
}
